# Server Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# Database
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/serene_space

# Session Configuration
# Generate a secure random string for production (e.g., using: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-key-change-in-production

# Frontend origin allowed to make credentialed cross-origin requests (production)
FRONTEND_URL=https://your-production-domain.com

# Bearer token required to read /metrics in production (openssl rand -hex 32)
METRICS_TOKEN=your-metrics-bearer-token

# Field-level encryption key for at-rest secrets (currently: MFA TOTP
# secrets). 64 hex chars = 32 bytes. Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Optional: CAPTCHA on signup/password-reset. Inert (no-op, doesn't block
# anyone) unless both are set. Recommended: Cloudflare Turnstile.
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get this from Stripe Dashboard > Developers > Webhooks > Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay Configuration (for Indian UPI payments)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# A DIFFERENT secret from RAZORPAY_KEY_SECRET above — this one signs webhook
# deliveries, not API calls, and is configured separately at
# https://dashboard.razorpay.com/app/webhooks (Add webhook > set this secret
# on the Razorpay side, then paste the same value here). Without it, every
# incoming Razorpay webhook fails closed with a 500 — no silent bypass, but
# also no webhook-based payment/dispute confirmation at all until it's set.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OpenAI Configuration
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
# Optional: Specify the model to use (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# WebRTC TURN relay for voice/video sessions (optional but strongly
# recommended for production — without it, calls only work when both
# sides are on networks that allow direct peer-to-peer connections).
# Get these from a Cloudflare Calls TURN app: dash.cloudflare.com > Calls > TURN
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Cloudflare R2 storage for professional verification documents (optional
# but required before real applications go through in production — without
# it, uploaded documents are stored on local disk and are LOST on every
# redeploy). Create a bucket + API token at dash.cloudflare.com > R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Crisis Alert Emails (optional but strongly recommended)
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Comma-separated list of emails that should be paged when a crisis signal is detected
CRISIS_ALERT_EMAIL=safety-team@yourdomain.com
# Must be an address on a domain verified in Resend; falls back to their shared
# test sender (onboarding@resend.dev) which only delivers to your own Resend account email
CRISIS_ALERT_FROM_EMAIL=alerts@yourdomain.com
